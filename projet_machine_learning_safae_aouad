    "# Njibo l'algorithme dyal Régression Logistique mn sklearn\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "# 1. Nkhl9o l'modele \n",
    "modele = LogisticRegression(max_iter=1000)\n",
    "\n",
    "# 2. Ndrbo l'modele b l'données dyal Train\n",
    "modele.fit(X_train, y_train)\n",
    "\n",
    "print(\"le modele est entrenne avec succes\")"
   ]
