    "import pandas as pd\n",
    "\n",
    "# 1. N9raw l'fichier\n",
    "df = pd.read_csv(\"student_lifestyle_dataset.csv\")\n",
    "df = df.drop('Student_ID', axis=1)\n",
    "\n",
    "# 2. N7owlo l'GPA l'no9ta mghribiya (3la 20)\n",
    "df['Note_Maroc'] = df['GPA'] * 5 \n",
    "\n",
    "# 3. Nsawbo l'Hadaf: 1 = Admis (ila jab 12/20 lfo9), 0 = Ajourné (ila jab 9el mn 12)\n",
    "df['Resultat_Concours'] = df['Note_Maroc'].apply(lambda x: 1 if x >= 12.0 else 0)\n",
    "\n",
    "# 4. N7iydo l'GPA w Note_Maroc bch l'modele yt3lem ghir mn l'mraja3a w n3as\n",
    "df = df.drop(['GPA', 'Note_Maroc'], axis=1)\n",
    "\n",
    "# 5. L'Encoding dyal Stress (Text -> Ar9am)\n",
    "df['Stress_Level'] = df['Stress_Level'].map({'Low': 0, 'Moderate': 1, 'High': 2})\n",
    "\n",
    "# Nchoufo l'tableau\n",
    "df.head()"
   ]
